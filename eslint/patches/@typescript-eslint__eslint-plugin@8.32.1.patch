+const { AST_NODE_TYPES } = require("@typescript-eslint/utils");
+const { isBuiltinSymbolLikeRecurser, isErrorLike, isSymbolFromDefaultLibrary, isTypeUnknownType } = require("@typescript-eslint/type-utils");
+
+const isDeclaredUnknown = (node, services) => {
+    const checker = services.program.getTypeChecker();
+    const symbol = checker.getSymbolAtLocation(services.esTreeNodeToTSNodeMap.get(node));
+    if (!symbol?.valueDeclaration) return false;
