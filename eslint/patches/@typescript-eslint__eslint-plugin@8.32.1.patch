+    const currentType = services.getTypeAtLocation(node);
+
+    return checker.getNonNullableType(currentType) === checker.getNonNullableType(declaredType);
+};
+
+const isForwardedFailure = (node, services) => {
+    if (node.type === AST_NODE_TYPES.ChainExpression) return isForwardedFailure(node.expression, services);
+
+    const hasFallback = node.type === AST_NODE_TYPES.LogicalExpression && node.operator === "??";
+    if (hasFallback) {
+        const hasErrorFallback = isErrorLike(services.program, services.getTypeAtLocation(node.right));
+
+        return hasErrorFallback && isForwardedFailure(node.left, services);
+    }
+
+    const isReasonRead = node.type === AST_NODE_TYPES.MemberExpression &&
+        !node.computed && node.property.type === AST_NODE_TYPES.Identifier && node.property.name === "reason";
+    if (!isReasonRead) return false;
+
+    const checker = services.program.getTypeChecker();
+    const ownerType = checker.getNonNullableType(services.getTypeAtLocation(node.object));
+
