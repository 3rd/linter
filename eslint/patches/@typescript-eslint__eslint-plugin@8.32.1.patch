+        const isLibraryFailure = (name === "AbortSignal" || name === "PromiseRejectedResult") &&
+            isSymbolFromDefaultLibrary(services.program, symbol);
+        if (isLibraryFailure) return true;
+
+        // Node's global declaration has no package-name entry for package-specifier matching.
+        const isNodeSignal = name === "AbortSignal" && symbol.getDeclarations()?.some((declaration) => {
+            const sourceFile = declaration.getSourceFile();
